{
  "description": "v2 role/team-brief acceptance manifest. Each scenario's payload validates against schemas/brief.schema.json (schema + semantic rules) and satisfies its checks. Deterministic — tests/test_acceptance_v2.py.",
  "checks_vocabulary": {
    "role_is": "payload.role equals value",
    "ranked": "all top_of_mind items have `rank` and are in ascending rank order",
    "max_top_of_mind": "top_of_mind length <= n",
    "min_top_of_mind": "top_of_mind length >= n",
    "has_conflict": "conflicts length >= 1, each citing >= 2 sources",
    "omission_category": "an omission with the given category exists",
    "no_say_contains": "no action.say contains the substring (injection safety)",
    "dedup_citation_count": "the item with dedup_key has exactly n citations (cross-source merge)",
    "calendar_all_day_first": "all-day events precede timed ones",
    "action_requires_approval": "every mutating action sets requires_approval=true",
    "capability_status": "a source_status with {capability} has {status}",
    "capability_not_active": "no source_status with {capability} is complete/partial (missing/blocked)",
    "source_present": "a source_status entry has source == value (provider substitution)",
    "distinct_workspaces_min": "items of {capability} cite >= {n} distinct workspaces"
  },
  "scenarios": [
    { "id": "01", "file": "01-engineer-brief.json", "title": "Engineer full brief",
      "checks": [ {"role_is": "software_engineer"}, {"ranked": true}, {"max_top_of_mind": 6},
                  {"capability_status": {"capability": "incidents", "status": "unavailable"}},
                  {"calendar_all_day_first": true}, {"action_requires_approval": true} ] },
    { "id": "e02", "file": "e02-missing-mandatory-code.json", "title": "Missing mandatory slot (code)",
      "checks": [ {"capability_not_active": "code"}, {"omission_category": "mandatory_slot_missing"}, {"min_top_of_mind": 1} ] },
    { "id": "e03", "file": "e03-substitution-m365-teams.json", "title": "Provider substitution: M365 + Teams",
      "checks": [ {"source_present": "m365_calendar"}, {"source_present": "teams"}, {"role_is": "software_engineer"} ] },
    { "id": "e04", "file": "e04-cross-source-dedup.json", "title": "Cross-source dedup (PR in 3 tools)",
      "checks": [ {"dedup_citation_count": {"dedup_key": "code:pr-acme-api-514", "count": 3}}, {"max_top_of_mind": 1} ] },
    { "id": "e05", "file": "e05-cross-source-conflict.json", "title": "Cross-source conflict (done vs open)",
      "checks": [ {"has_conflict": true} ] },
    { "id": "e06", "file": "e06-revoked-connector-isolation.json", "title": "Revoked connector isolation",
      "checks": [ {"capability_status": {"capability": "chat", "status": "unavailable"}}, {"min_top_of_mind": 1}, {"omission_category": "source_unavailable"} ] },
    { "id": "e07", "file": "e07-prompt-injection-slack.json", "title": "Prompt injection in a Slack message",
      "checks": [ {"no_say_contains": "merge"}, {"no_say_contains": "token"}, {"no_say_contains": "ignore previous"}, {"action_requires_approval": true} ] },
    { "id": "e08", "file": "e08-multi-workspace-scope.json", "title": "Multi-workspace scope (two repos)",
      "checks": [ {"distinct_workspaces_min": {"capability": "code", "n": 2}} ] },
    { "id": "e09", "file": "e09-partial-rate-limited.json", "title": "Partial / rate-limited source",
      "checks": [ {"capability_status": {"capability": "code", "status": "partial"}}, {"omission_category": "over_limit"} ] },
    { "id": "d01", "file": "d01-designer-brief.json", "title": "Designer brief (role-generality)",
      "checks": [ {"role_is": "product_designer"}, {"capability_status": {"capability": "design", "status": "complete"}}, {"min_top_of_mind": 1} ] },
    { "id": "r-dl", "file": "r-design-lead.json", "title": "Design Lead brief",
      "checks": [ {"role_is": "design_lead"}, {"ranked": true}, {"capability_status": {"capability": "design", "status": "complete"}}, {"min_top_of_mind": 2} ] },
    { "id": "r-el", "file": "r-engineering-lead.json", "title": "Engineering Lead brief (incident-first)",
      "checks": [ {"role_is": "engineering_lead"}, {"ranked": true}, {"capability_status": {"capability": "incidents", "status": "complete"}}, {"min_top_of_mind": 3} ] },
    { "id": "r-pm", "file": "r-product-manager.json", "title": "Product Manager brief",
      "checks": [ {"role_is": "product_manager"}, {"ranked": true}, {"capability_status": {"capability": "support", "status": "complete"}}, {"omission_category": "source_unavailable"} ] },
    { "id": "r-hop", "file": "r-head-of-product.json", "title": "Head of Product brief (support-first)",
      "checks": [ {"role_is": "head_of_product"}, {"ranked": true}, {"capability_status": {"capability": "support", "status": "complete"}} ] },
    { "id": "r-qa", "file": "r-qa-engineer.json", "title": "QA Engineer brief",
      "checks": [ {"role_is": "qa_engineer"}, {"ranked": true}, {"capability_status": {"capability": "tracking", "status": "complete"}} ] },
    { "id": "r-da", "file": "r-data-analyst.json", "title": "Data Analyst brief (analytics has no connector)",
      "checks": [ {"role_is": "data_analyst"}, {"ranked": true}, {"omission_category": "source_unavailable"} ] },
    { "id": "r-sh", "file": "r-superhuman.json", "title": "Superhuman brief (many hats, own connector mix)",
      "checks": [ {"role_is": "superhuman"}, {"ranked": true}, {"min_top_of_mind": 3}, {"calendar_all_day_first": true},
                  {"action_requires_approval": true}, {"omission_category": "source_unavailable"} ] }
  ]
}
