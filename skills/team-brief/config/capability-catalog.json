{
  "version": "1.0",
  "description": "Capability slots (jobs-to-be-done) and the interchangeable providers that fill them. Substitution lives here: a slot is satisfied by any one of its providers. `min`/`max` bound how many providers a user may connect for that slot. Provider `sources` map to the `source` enum in schemas/brief.schema.json. AVAILABILITY GATE: a provider is offered to users only if it is connectable today — `native_connector: true` (or a future `custom_connector: true`). Providers with neither (e.g. Amplitude/Mixpanel/PostHog/ClickUp/Opsgenie/Grafana/Zendesk/Bitbucket) remain here as ROADMAP but are never surfaced in onboarding; a slot whose providers are all unconnectable (e.g. analytics today) is hidden entirely. See lib/gating.py. Decision 2026-08-07: v2 ships native-only; custom connectors (Phase 9) deferred.",
  "capabilities": {
    "productivity": { "label": "Productivity (email, calendar, docs)", "providers": ["google_workspace", "microsoft_365"], "min": 1, "max": 1 },
    "chat":         { "label": "Team chat", "providers": ["slack", "microsoft_teams"], "min": 1, "max": 2 },
    "design":       { "label": "Design", "providers": ["figma"], "min": 1, "max": 1 },
    "code":         { "label": "Code / version control", "providers": ["github", "gitlab", "bitbucket"], "min": 1, "max": 3 },
    "tracking":     { "label": "Issue / project tracking", "providers": ["jira", "linear", "asana", "clickup"], "min": 1, "max": 4 },
    "docs":         { "label": "Docs / knowledge", "providers": ["notion", "confluence", "google_docs", "sharepoint"], "min": 0, "max": 4 },
    "incidents":    { "label": "Incidents / on-call", "providers": ["pagerduty", "opsgenie"], "min": 0, "max": 2 },
    "observability":{ "label": "Observability", "providers": ["datadog", "sentry", "grafana"], "min": 0, "max": 3 },
    "support":      { "label": "Customer support / feedback", "providers": ["intercom", "zendesk"], "min": 0, "max": 2 },
    "analytics":    { "label": "Product analytics", "providers": ["amplitude", "mixpanel", "posthog"], "min": 0, "max": 3 }
  },
  "providers": {
    "google_workspace": { "label": "Google Workspace", "native_connector": true, "sources": ["gmail", "calendar", "drive"] },
    "microsoft_365":    { "label": "Microsoft 365", "native_connector": true, "sources": ["m365_mail", "m365_calendar", "m365_files", "teams"] },
    "slack":            { "label": "Slack", "native_connector": true, "sources": ["slack"] },
    "microsoft_teams":  { "label": "Microsoft Teams", "native_connector": true, "via": "microsoft_365", "sources": ["teams"] },
    "figma":            { "label": "Figma", "native_connector": true, "sources": ["figma"] },
    "github":           { "label": "GitHub", "native_connector": true, "sources": ["github"] },
    "gitlab":           { "label": "GitLab", "native_connector": true, "sources": ["gitlab"] },
    "bitbucket":        { "label": "Bitbucket", "native_connector": false, "sources": ["bitbucket"] },
    "jira":             { "label": "Jira", "native_connector": true, "sources": ["jira"] },
    "linear":           { "label": "Linear", "native_connector": true, "sources": ["linear"] },
    "asana":            { "label": "Asana", "native_connector": true, "sources": ["asana"] },
    "clickup":          { "label": "ClickUp", "native_connector": false, "sources": ["clickup"] },
    "notion":           { "label": "Notion", "native_connector": true, "sources": ["notion"] },
    "confluence":       { "label": "Confluence", "native_connector": true, "sources": ["confluence"] },
    "google_docs":      { "label": "Google Docs", "native_connector": true, "via": "google_workspace", "sources": ["drive"] },
    "sharepoint":       { "label": "SharePoint", "native_connector": true, "via": "microsoft_365", "sources": ["m365_files"] },
    "pagerduty":        { "label": "PagerDuty", "native_connector": true, "sources": ["pagerduty"] },
    "opsgenie":         { "label": "Opsgenie", "native_connector": false, "sources": ["opsgenie"] },
    "datadog":          { "label": "Datadog", "native_connector": true, "sources": ["datadog"] },
    "sentry":           { "label": "Sentry", "native_connector": true, "sources": ["sentry"] },
    "grafana":          { "label": "Grafana", "native_connector": false, "sources": ["grafana"] },
    "intercom":         { "label": "Intercom", "native_connector": true, "sources": ["intercom"] },
    "zendesk":          { "label": "Zendesk", "native_connector": false, "sources": ["zendesk"] },
    "amplitude":        { "label": "Amplitude", "native_connector": false, "sources": ["amplitude"] },
    "mixpanel":         { "label": "Mixpanel", "native_connector": false, "sources": ["mixpanel"] },
    "posthog":          { "label": "PostHog", "native_connector": false, "sources": ["posthog"] }
  }
}
