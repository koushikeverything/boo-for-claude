# Boo connector configuration. Copy to .env and fill in. NEVER commit the real .env.
# Generate a key:  python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"

# --- Envelope encryption (versioned registry: "version:base64url32B,version:base64url32B") ---
BOO_ENC_KEYS=1:REPLACE_WITH_BASE64URL_32_BYTES
BOO_ENC_CURRENT_VERSION=1
BOO_CRYPTO_BACKEND=hmac-ctr        # or "aesgcm" (requires the cryptography package)

# --- Signed OAuth state secret (HMAC key for single-use state tokens) ---
BOO_STATE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# --- Storage ---
BOO_DB_PATH=/data/boo.db           # SQLite path (or swap for a Postgres DSN in production)

# --- Public hosting (must be public HTTPS for Cowork to reach it) ---
BOO_PUBLIC_BASE_URL=https://boo-connector.example.com

# --- Fixtures mode (no Google creds needed; for local/dev/testing) ---
BOO_USE_FIXTURES=false

# --- Google OAuth (LIVE only; not needed in fixtures mode) ---
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_REDIRECT_URI=https://boo-connector.example.com/oauth/callback
# Optional space-separated scope override (defaults are read-only + gmail.compose + calendar.events):
# GOOGLE_SCOPES=openid email https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/drive.metadata.readonly
